{
  "name": "pdf-gallery",
  "version": "1.2.0",
  "description": "pdf-gallery",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "repository": "https://github.com/Rebel1898/PDFGallery",
  "keywords": [
    "Electron",
    "pdf",
    "gallery",
    "viewer",
    "demo"
  ],
  "author": "Rebel1898",
  "license": "CC0-1.0",
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-prompt": "^1.7.0",
    "smalltalk": "^4.0.7"
  },
  "build": {
    "appId": "com.electron.pdf-gallery",
    "asar": true,
    "fileAssociations": [
      {
        "ext": ".PDF",
        "name": "PDF Files"
      }
    ],
    "productName": "pdf-gallery",
    "files": [
      "node_modules/**/*",
      "src/**/*",
      "package.json",
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "PDF_icon4.png"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icons/logo_1026.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "icons/logo_1026.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "icons/logo_1026.ico"
    }
  }
}
